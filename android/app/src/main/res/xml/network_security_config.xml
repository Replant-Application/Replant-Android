<?xml version="1.0" encoding="utf-8"?>
<!--
  실기기에서 HTTP(비암호화) API 연결이 막히는 문제 방지.
  일부 기기/OS에서는 usesCleartextTraffic만으로는 HTTP가 차단되므로
  API 호스트에 대해 명시적으로 cleartext 허용.
-->
<network-security-config>
  <!-- 백엔드 API 서버 (EC2) - HTTP 명시 허용 -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">ec2-43-202-76-241.ap-northeast-2.compute.amazonaws.com</domain>
  </domain-config>
  <!-- 로컬 개발: 에뮬 10.0.2.2, 실기기에서 PC IP(192.168.x.x) 사용 시 -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>
  <!-- 기타 HTTP 필요 시 (예: 예전 서버 IP) -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">113.198.66.73</domain>
  </domain-config>
</network-security-config>
