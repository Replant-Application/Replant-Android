{
  "name": "ReplantMobileApp",
  "version": "1.0.25",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "react-native start",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:release": "cd android && ./gradlew bundleRelease assembleRelease && cd ../.. && powershell -Command \"$version = (Get-Content Replant/package.json | ConvertFrom-Json).version; $apkSrc = Get-ChildItem 'Replant/android/app/build/outputs/apk/release/*.apk' | Select-Object -First 1; $aabSrc = Get-ChildItem 'Replant/android/app/build/outputs/bundle/release/*.aab' | Select-Object -First 1; Copy-Item $apkSrc.FullName builds/replant-release-$version.apk; Copy-Item $aabSrc.FullName builds/replant-release-$version.aab; Write-Host 'Copied to builds/replant-release-'$version'.apk and .aab'\"",
    "clean": "cd android && ./gradlew clean && cd .. && rm -rf node_modules/.cache",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.32",
    "@amplitude/plugin-session-replay-react-native": "^0.4.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^4.5.7",
    "@react-native-firebase/app": "^23.8.2",
    "@react-native-firebase/messaging": "^23.8.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@react-native/new-app-screen": "0.81.4",
    "expo": "^54.0.30",
    "expo-asset": "^12.0.12",
    "expo-av": "^16.0.8",
    "expo-font": "^14.0.10",
    "expo-location": "~19.0.8",
    "expo-speech-recognition": "^3.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-fast-image": "^8.6.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "^15.15.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@react-navigation/native": "^7.1.19",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4",
    "@isaacs/brace-expansion": ">=5.0.1"
  }
}
