# Replant 프론트엔드 환경설정
# 이 파일을 복사하여 .env로 이름을 변경하고 실제 값을 입력하세요.

# ============================================
# 백엔드 API 설정
# ============================================

# 개발 환경 - 로컬 서버
# API_BASE_URL=http://localhost:8080/api

# 개발 환경 - Android 에뮬레이터 (호스트 머신 접근)
# API_BASE_URL=http://10.0.2.2:8080/api

# 프로덕션 환경
# API_BASE_URL=https://api.replant.com/api

# API 타임아웃 (밀리초)
API_TIMEOUT=10000

# ============================================
# OAuth 설정
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Kakao OAuth (선택사항)
# KAKAO_APP_KEY=your_kakao_app_key

# Naver OAuth (선택사항)
# NAVER_CLIENT_ID=your_naver_client_id

# Apple OAuth (선택사항)
# APPLE_CLIENT_ID=your_apple_client_id

# ============================================
# 외부 API 키
# ============================================

# 카카오맵 API 키
KAKAO_MAP_API_KEY=your_kakao_map_api_key
