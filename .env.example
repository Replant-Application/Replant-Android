# Replant Backend API Configuration
# 백엔드 API 기본 URL을 설정하세요

# 개발 환경 - 로컬 서버
API_BASE_URL=http://localhost:8080/api

# 프로덕션 환경 - 클라우드 백엔드 서버
# API_BASE_URL=http://ec2-43-202-76-241.ap-northeast-2.compute.amazonaws.com:8080/api

# OAuth 설정 (필요시 추가)
KAKAO_APP_KEY=your_kakao_app_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# API 타임아웃 (밀리초)
API_TIMEOUT=10000

# 카카오맵 API 키 (근처 상담센터 장소 검색, REST API 키)
KAKAO_MAP_API_KEY=your_kakao_rest_api_key

# Amplitude Analytics API Key
AMPLITUDE_API_KEY=your_amplitude_api_key
