# Replant Backend API Configuration
# 백엔드 API 기본 URL을 설정하세요

# 개발 환경 - 로컬 서버
# API_BASE_URL=http://localhost:8080/api

# 개발 환경 - 실제 서버
# API_BASE_URL=http://113.198.66.75:13150/api

# 프로덕션 환경
# API_BASE_URL=https://api.replant.com/api

# OAuth 설정 (필요시 추가)
# KAKAO_APP_KEY=your_kakao_app_key
# GOOGLE_CLIENT_ID=your_google_client_id
# NAVER_CLIENT_ID=your_naver_client_id
# APPLE_CLIENT_ID=your_apple_client_id

# API 타임아웃 (밀리초)
API_TIMEOUT=10000
